INFLUXDB_HOST=http://localhost:8181
INFLUXDB_TOKEN=apiv3_REPLACE_ME
# Optional: the database whose system tables to inspect (default: _internal)
INFLUXDB_DATABASE=_internal
# Optional: server data dir, for local-disk usage stats (file object store only)
INFLUXDB_DATA_DIR=
# Optional: absolute path to the influxdb3 CLI binary (if not on PATH)
INFLUXDB3_CLI=
